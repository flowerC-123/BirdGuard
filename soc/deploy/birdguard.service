[Unit]
Description=BirdGuard UART inference service
After=local-fs.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/birdguard/soc
EnvironmentFile=/etc/birdguard.env
ExecStartPre=/bin/sleep 20
ExecStart=/bin/bash /opt/birdguard/soc/deploy/run.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
